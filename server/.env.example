# Copy this file to .env and fill in the values. Never commit .env.

# --- Server ---
PORT=3000
# debug | info | warn | error
LOG_LEVEL=info
# Only needed if the client is served from a different origin (comma-separated list),
# e.g. http://localhost:4200. Leave empty when NGINX serves client and API together.
CORS_ORIGIN=
# Reverse proxies trusted for X-Forwarded-For (Express "trust proxy" syntax).
# loopback = NGINX on the same host; Docker Compose sets it to the private network.
TRUST_PROXY=loopback

# --- Amazon Cognito ---
# The app client must have no secret and allow the USER_PASSWORD_AUTH and
# REFRESH_TOKEN_AUTH flows. No AWS credentials are needed for these calls.
AWS_REGION=eu-west-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=

# --- PostgreSQL (Amazon RDS) ---
# For the database of docker-compose.yml (`docker compose up -d db`) use:
#   DB_HOST=localhost DB_NAME=mailspace DB_USER=mailspace DB_PASSWORD=mailspace DB_SSL=false
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# TLS certificate verification. For RDS download the CA bundle with
#   curl -o global-bundle.pem https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
# and set its path here.
DB_CA_PATH=
# Set to false only for a local PostgreSQL without TLS
DB_SSL=true

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
# Any Gemini model that supports JSON output
GEMINI_MODEL=gemini-3.5-flash-lite
