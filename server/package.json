{
  "name": "mail-space-server",
  "version": "2.0.0",
  "private": true,
  "description": "REST API of Mail Space: e-mail storage, AI tagging with Google Gemini, search and folders",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js | pino-pretty",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest --runInBand",
    "test:unit": "jest --selectProjects unit",
    "test:coverage": "jest --runInBand --coverage"
  },
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1138.0",
    "@google/genai": "^2.24.0",
    "aws-jwt-verify": "^5.2.1",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mailparser": "^3.9.28",
    "multer": "^2.0.1",
    "pg": "^8.12.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "aws-sdk-client-mock": "^4.1.0",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0"
  }
}
